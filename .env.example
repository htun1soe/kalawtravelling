# VITE_API_BASE_URL: Base URL for the Express REST API (defaults to /api when served from server.ts).
VITE_API_BASE_URL="/api"

# Interactive Maps: Powered by OpenStreetMap + Leaflet + OSRM (no API key or billing required).

# APP_URL: Public URL of the deployed web application.
APP_URL="http://localhost:3000"
